# ==============================================================================
# PureBlend Food Chemicals — Environment Variables Template
# Copy this file to .env.local for local development. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Browser Configuration (Safe for client bundle)
#    Prefix with NEXT_PUBLIC_ to expose to the browser.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Toggle mock data mode (true for frontend dev without database; false for real backend)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Firebase Client Configuration (Public - safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK — Server-Only Secrets
#    NEVER expose these to the browser. Used by backend/API routes only.
#    Obtain from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key must be escaped for .env (replace actual newlines with \n)
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. Cloudinary — Server-Only Secrets
#    Used for image/media upload and management. NEVER expose API_SECRET to browser.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. SMTP Email Gateway — Contact Form (Server-Only Secrets)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PureBlend Inquiries <no-reply@pureblend.example.com>
CONTACT_RECIPIENT=inquiries@pureblend.example.com

# ------------------------------------------------------------------------------
# 5. AI & RAG Subsystem (Server-Only Secrets)
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
RAG_SIMILARITY_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# 6. Authentication & Session Security (Server-Only Secrets)
#    Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
AUTH_SECRET=replace-with-a-secure-random-64-character-hex-string
# Set these privately in .env.local only when running npm run admin:bootstrap.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Legacy Database (PostgreSQL/Prisma) — Deprecated
#    Kept for reference during migration. Will be removed in future phases.
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pureblend?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pureblend?schema=public"