# ==============================================================================
# PureBlend Food Chemicals — Environment Variables Template
# Copy this file to .env.local for local development. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Browser Configuration (Safe for client bundle)
# ------------------------------------------------------------------------------
# In Next.js, leave empty for same-origin relative API calls (e.g. /api/contact)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Toggle mock data mode (true for frontend dev without database; false for real backend)
NEXT_PUBLIC_USE_MOCK_DATA=true

# ------------------------------------------------------------------------------
# 2. Database & Prisma ORM (Server-Only Secrets)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pureblend?schema=public"
# DIRECT_URL is required for migrations when using pooled connections like Supabase/Neon
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pureblend?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security (Server-Only Secrets)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-secure-random-64-character-hex-string"
ADMIN_INITIAL_EMAIL="admin@pureblend.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction!2026"

# ------------------------------------------------------------------------------
# 4. AI & RAG Subsystem (Server-Only Secrets)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
RAG_SIMILARITY_THRESHOLD="0.70"

# ------------------------------------------------------------------------------
# 5. SMTP Email Gateway — Contact Form (Server-Only Secrets)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.provider.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="PureBlend Inquiries <no-reply@pureblend.example.com>"
CONTACT_RECIPIENT="inquiries@pureblend.example.com"

# ------------------------------------------------------------------------------
# 6. Object & Image Storage (Server-Only Secrets)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="pureblend-media"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
