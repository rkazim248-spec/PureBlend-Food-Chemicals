# ── Public (safe for the browser) ────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" uses /src/mocks fixtures instead of the real backend.
# Development-only. Production must unset this or set it to "false".
NEXT_PUBLIC_USE_MOCK_DATA=true

# ── Server-only (NEVER expose these in the browser or commit real values) ────
# DATABASE_URL=<SECRET>
# SMTP_PASSWORD=<SECRET>
# AI_API_KEY=<SECRET>
# AUTH_SECRET=<SECRET>
